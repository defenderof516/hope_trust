# Cloudflare R2 — Hope Trust asset bucket
# Copy to .env.local and fill in real values from the Cloudflare dashboard.

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

R2_BUCKET=hopetrust
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Public read URL for the bucket (safe to expose in the built site)
NEXT_PUBLIC_R2_BASE=
